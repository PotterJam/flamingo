#!/bin/sh

# On Fly, name the node after its private IPv6 so DNSCluster (querying
# flamingo.internal, see fly.toml) can connect the machines into one
# cluster. Rooms are registered globally, so any machine can serve any
# player once clustered.
if [ -n "${FLY_PRIVATE_IP:-}" ]; then
  export ERL_AFLAGS="-proto_dist inet6_tcp"
  export RELEASE_DISTRIBUTION="name"
  export RELEASE_NODE="flamingo@${FLY_PRIVATE_IP}"
fi
